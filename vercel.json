{
  "buildCommand": "npm --prefix client run build",
  "installCommand": "npm --prefix client ci",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://abayabrand.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
